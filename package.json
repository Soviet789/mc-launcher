{
  "name": "mc-launcher",
  "productName": "MC Launcher",
  "version": "0.1.0",
  "description": "跨平台 Minecraft 启动器（Windows / Ubuntu）",
  "homepage": "https://github.com/Soviet789/mc-launcher",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Soviet789/mc-launcher.git"
  },
  "bugs": {
    "url": "https://github.com/Soviet789/mc-launcher/issues"
  },
  "main": "electron/main.js",
  "author": "MC Launcher Team",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:renderer": "vite build",
    "start": "vite build && electron .",
    "build": "vite build && electron-builder --publish never",
    "build:win": "vite build && electron-builder --win --publish never",
    "build:linux": "vite build && electron-builder --linux --publish never",
    "build:dir": "vite build && electron-builder --dir --publish never",
    "selftest": "node scripts/selftest.mjs",
    "ui-check": "electron --no-sandbox scripts/ui-check.cjs",
    "e2e": "electron scripts/e2e-test.cjs",
    "gen-icon": "node scripts/gen-icon.mjs"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "pinia": "^2.3.0",
    "vite": "^6.0.7",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  }
}
